import time
import board
import busio
import adafruit_tca9548a

print("--- Raspberry Pi 3B I2C Multiplexer Initializing ---")

# Step 1: Wake up the Pi 3B's hardware I2C pins (Physical Pins 3 and 5)
i2c = busio.I2C(board.SCL, board.SDA)

# Step 2: Inform the script that the Multiplexer is resting at default address 0x70
tca = adafruit_tca9548a.TCA9548A(i2c)

# Step 3: Continuously loop through the 4 active sensor tracks
try:
    while True:
        for channel in range(4):
            print(f"Opening Multiplexer Channel: {channel}")
            
            # This 'tca[channel]' object represents the target sensor's private bus line
            active_bus = tca[channel]
            
            # --- INTEGRATE SENSOR INTERFACE HERE ---
            # Right now, any command passed through 'active_bus' maps only to that channel.
            # Example placeholder:
            # sensor = YourSensorLibrary(active_bus)
            # print(sensor.magnetic_field)
            # ---------------------------------------
            
            time.sleep(0.2)  # Pause 200ms before switching tracks
            
        print("----------------------------------------------")
        time.sleep(2)  # Wait 2 seconds before repeating the whole cycle

except KeyboardInterrupt:
    print("\nScript stopped by user.")
